# =============================================================================
# .env.example — Template konfigurasi lokal
# =============================================================================
# Salin file ini menjadi ".env" dan isi nilainya dengan data asli Anda.
#
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env  (Windows)
#
# PENTING:
#   - File ".env" sudah masuk .gitignore — JANGAN pernah di-commit ke Git.
#   - Di Render: set env var yang sama via Dashboard → Service → Environment.
# =============================================================================

# --- User: Zaky ---
ZAKY_MOODLE_USERNAME=username_moodle_kamu
ZAKY_MOODLE_PASSWORD=password_moodle_kamu
ZAKY_TELEGRAM_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxx
ZAKY_TELEGRAM_CHATID=987654321

# --- Tambahkan user lain di bawah jika diperlukan ---
# TEMAN_MOODLE_USERNAME=username_teman
# TEMAN_MOODLE_PASSWORD=password_teman
# TEMAN_TELEGRAM_TOKEN=token_bot_teman
